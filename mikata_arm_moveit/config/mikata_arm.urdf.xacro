<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="mikata_arm">
    <!-- MoveIt configuration: Robot model without ros2_control -->
    <xacro:arg name="prefix" default="" />

    <!-- Include robot model only -->
    <xacro:include filename="$(find mikata_arm_description)/urdf/mikata_arm.xacro" />

    <!-- Base link -->
    <link name="$(arg prefix)base_link" />

    <!-- Robot arm (without ros2_control for MoveIt) -->
    <xacro:mikata_arm
        prefix="$(arg prefix)"
        parent="$(arg prefix)base_link">
        <origin xyz="0 0 0" rpy="0 0 0" />
    </xacro:mikata_arm>
</robot>
