<?xml version="1.0"?>
<!-- MikataArm 6-axis robot -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="mikata_arm">
  <!-- Arguments -->
  <xacro:arg name="prefix" default="" />
  <xacro:arg name="use_ros2_control" default="true" />
  <xacro:arg name="use_fake_hardware" default="false" />
  <xacro:arg name="initial_positions_file" default="$(find mikata_arm_description)/config/initial_positions.yaml" />

  <!-- Include robot model -->
  <xacro:include filename="$(find mikata_arm_description)/urdf/mikata_arm.xacro" />

  <!-- Conditionally include ros2_control description -->
  <xacro:if value="$(arg use_ros2_control)">
    <xacro:include filename="$(find mikata_arm_description)/urdf/mikata_arm.ros2_control.xacro" />
  </xacro:if>

  <!-- Base link -->
  <link name="$(arg prefix)base_link" />

  <!-- Robot arm -->
  <xacro:mikata_arm
      prefix="$(arg prefix)"
      parent="$(arg prefix)base_link">
    <origin xyz="0 0 0" rpy="0 0 0" />
  </xacro:mikata_arm>

  <!-- Conditionally add ros2_control hardware interface -->
  <xacro:if value="$(arg use_ros2_control)">
    <xacro:mikata_arm_ros2_control
      name="mikata_arm"
      prefix="$(arg prefix)"
      use_fake_hardware="$(arg use_fake_hardware)"
      initial_positions_file="$(arg initial_positions_file)" />
  </xacro:if>

</robot>