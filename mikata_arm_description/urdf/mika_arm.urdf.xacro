<?xml version="1.0"?>
<!-- MikataArm 6-axis robot -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="mikata_arm">
  <xacro:arg name="prefix" default="" />

  <xacro:include filename="$(find mikata_arm_description)/urdf/mikata_arm.xacro" />

  <!-- Import mikata_arm ros2_control description -->
  <!-- <xacro:include filename="$(find mikata_arm_description)/ros2_control/mikata_arm.ros2_control.xacro" /> -->

  <link name="$(arg prefix)base_link" />

  <xacro:mikata_arm
      prefix="$(arg prefix)"
      parent="$(arg prefix)base_link">
    <origin
        xyz="0 0 0"
        rpy="0 0 0" />
  </xacro:mikata_arm>

  <!-- <xacro:mikata_arm_ros2_control
    name="mikata_arm" prefix="$(arg prefix)" /> -->

</robot>