{
    "name": "MikataArm MoveIt2 Humble Dev",
    "dockerComposeFile": "../docker/docker-compose.yml",
    "service": "mikata-arm-dev",
    "workspaceFolder": "/home/ros/ws_mikata_arm",
    "remoteUser": "ros",
    "initializeCommand": "xhost +local:docker",
    "shutdownAction": "stopCompose",
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-vscode.cpptools",
                "ms-python.python",
                "ms-iot.vscode-ros",
                "zachflower.uncrustify"
            ],
            "settings": {
                "terminal.integrated.defaultProfile.linux": "bash",
                "terminal.integrated.profiles.linux": {
                    "bash": {
                        "path": "/bin/bash",
                        "args": ["-l"]
                    }
                }
            }
        }
    },
    // コンテナ作成後にrosdepを更新する場合
    // "postStartCommand": "source /opt/ros/humble/setup.bash && test -f /home/ros/ws_mikata_arm/install/setup.bash && source /home/ros/ws_mikata_arm/install/setup.bash || true"
}